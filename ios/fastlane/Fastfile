default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Upload an already-built IPA to TestFlight"
  lane :beta do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ENV.fetch("IPA_PATH"),
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Submit an already-uploaded TestFlight build for App Store review"
  lane :release do
    deliver(
      api_key: asc_api_key,
      app_version: ENV.fetch("APP_VERSION"),
      build_number: ENV.fetch("BUILD_NUMBER"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: ENV.fetch("AUTOMATIC_RELEASE", "false") == "true",
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
